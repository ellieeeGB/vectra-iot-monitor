# Copia este archivo como .env y llena DATABASE_URL. NUNCA subas .env a Git.

BACKEND_PORT=8000
FRONTEND_PORT=5173

# Supabase > Project Settings > Database > Connection string (URI).
# Usa el "Session pooler" o la conexión directa; reemplaza [YOUR-PASSWORD].
DATABASE_URL=postgresql://postgres.xxxx:[YOUR-PASSWORD]@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# Orígenes permitidos por CORS (el dashboard). Separa varios con coma.
CORS_ORIGINS=http://localhost:5173

# URL del backend vista desde el navegador (se incrusta al compilar el frontend).
VITE_API_URL=http://localhost:8000

# Segundos sin lecturas para considerar un dispositivo OFFLINE.
ONLINE_SECONDS=15
